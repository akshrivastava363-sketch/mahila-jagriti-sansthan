{
  // ─── Cloudflare Workers config for Mahila Jagriti Sansthan ───
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/

  "name": "mjs-website",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",

  // Static HTML/CSS/JS served from ./public folder
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // R2 bucket for gallery photos and PDF reports
  // Create bucket first: wrangler r2 bucket create mjs-uploads
  "r2_buckets": [
    {
      "binding": "MJS_BUCKET",
      "bucket_name": "mjs-uploads",
      // Preview bucket for local dev (wrangler dev)
      "preview_bucket_name": "mjs-uploads-preview"
    }
  ]

  // ─── IMPORTANT: Set admin token as a secret (not in this file) ───
  // Run: wrangler secret put ADMIN_TOKEN
  // When prompted, enter: MJS@2024
  // (or a stronger password — also update UPASS in public/index.html)
}
